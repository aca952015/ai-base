# Local defaults in compose.yaml are only for loopback-only validation.
# Set these values before sharing the host or moving to staging/production.
AI_BASE_POSTGRES_PASSWORD=replace-with-a-random-password
# 模型渠道 Key 仅用于 Console 尚未保存渠道时的 standalone 回退；常规配置请使用 Console。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OOMOL_CONNECT_ENCRYPTION_KEY=replace-with-a-stable-random-encryption-key
OOMOL_CONNECT_ADMIN_TOKEN=replace-with-a-random-admin-token
OOMOL_CONNECT_RUNTIME_TOKEN=replace-with-a-random-runtime-token
SILVERBULLET_USER=admin:replace-with-a-random-password

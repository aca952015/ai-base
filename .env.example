# Local defaults in compose.yaml are only for loopback-only validation.
# Set these values before sharing the host or moving to staging/production.
AI_BASE_POSTGRES_PASSWORD=replace-with-a-random-password
AI_CONSOLE_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
AI_CONSOLE_ADMIN_EMAILS=admin@bluetron.cn
AI_CONSOLE_DEV_IDENTITY_ENABLED=false
# 模型渠道 Key 仅用于 Console 尚未保存渠道时的 standalone 回退；常规配置请使用 Console。
GLOBAL_GATEWAY_URL=http://localhost:8080
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OOMOL_CONNECT_ENCRYPTION_KEY=replace-with-a-stable-random-encryption-key
OOMOL_CONNECT_ADMIN_TOKEN=replace-with-a-random-admin-token
OOMOL_CONNECT_RUNTIME_TOKEN=replace-with-a-random-runtime-token
OOMOL_CONNECT_ORIGIN=https://open-connector.localhost.pomerium.io:8443
POMERIUM_IDP_PROVIDER_URL=http://dex.localtest.me:5556/dex
POMERIUM_IDP_CLIENT_ID=ai-base-pomerium
POMERIUM_IDP_CLIENT_SECRET=replace-with-a-random-client-secret
POMERIUM_COOKIE_SECRET=replace-with-base64-32-byte-secret
POMERIUM_SHARED_SECRET=replace-with-base64-32-byte-secret
MCP_PUBLIC_RESOURCE_URL=http://127.0.0.1:8080/mcp
MCP_OIDC_ISSUER=http://127.0.0.1:8080/oauth
MCP_OIDC_AUDIENCE=http://127.0.0.1:8080/mcp
MCP_OIDC_REQUIRED_SCOPES=ai-base:mcp
MCP_LOGIN_OIDC_ISSUER=http://dex.localtest.me:5556/dex
MCP_LOGIN_OIDC_CLIENT_ID=ai-base-mcp-broker
MCP_LOGIN_OIDC_REDIRECT_URL=http://127.0.0.1:8080/oauth/callback
MCP_CONNECTOR_BINDING_RESOLVER_TOKEN=replace-with-a-long-random-internal-token
MCP_OAUTH_ALLOWED_REDIRECT_URIS=workbuddy://workbuddy/mcp/custom-mcp%3Aai-base/oauth/callback
MCP_OAUTH_ACCESS_TOKEN_LIFETIME=1h
MCP_OAUTH_REFRESH_TOKEN_LIFETIME=2160h
MCP_SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
MCP_SESSION_LIFETIME=2160h
MCP_ADMIN_TOKEN=replace-with-a-random-admin-token
LIGHTRAG_API_KEY=replace-with-a-random-api-key
LIGHTRAG_ADMIN_TOKEN=replace-with-a-random-internal-admin-token
LIGHTRAG_LLM_MODEL=qwen
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3
LIGHTRAG_EMBEDDING_DIM=1024
LIGHTRAG_EMBEDDING_TOKEN_LIMIT=8192

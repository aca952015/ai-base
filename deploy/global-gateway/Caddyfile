{
	admin off
}

http://:8080 {
	header X-AI-Base-Gateway "functional"

	route {
		handle /health {
			header Content-Type application/json
			respond `{"status":"ok","service":"ai-base-global-gateway"}`
		}

		handle /ready {
			rewrite * /health
			reverse_proxy llm-gateway:1064
		}

		@wecomDomainVerification path_regexp wecomVerification ^/WW_verify_[A-Za-z0-9_-]+\.txt$
		handle @wecomDomainVerification {
			root * /srv/wecom-verification
			file_server
		}

		@models path /v1 /v1/*
		handle @models {
			reverse_proxy llm-gateway:1975 {
				header_up X-AI-Base-Traffic-Origin external_gateway
				header_up -traceparent
				header_up -tracestate
				header_up -baggage
				header_up -b3
				header_up -x-b3-traceid
				header_up -x-b3-spanid
				header_up -x-b3-parentspanid
				header_up -x-b3-sampled
				header_up -x-b3-flags
				header_up -x-request-id
				header_up -x-client-trace-id
				header_up -x-envoy-force-trace
				header_up -uber-trace-id
				header_up -x-ot-span-context
				header_up -ot-tracer-traceid
				header_up -ot-tracer-spanid
				header_up -ot-tracer-sampled
				header_up -grpc-trace-bin
				header_up -x-cloud-trace-context
				header_up -x-goog-cloud-trace-context
				header_up -x-amzn-trace-id
				header_up -agent-session-id
				header_up -x-session-id
				header_up -session-id
				header_up -x-user-id
				header_up -x-auth-request-user
				header_up -x-auth-request-email
				header_up -x-forwarded-user
				flush_interval -1
			}
		}

		@mcpMetadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
		handle @mcpMetadata {
			reverse_proxy mcp-access-gateway:8081
		}

		@mcpOAuth path /.well-known/oauth-authorization-server/oauth /.well-known/openid-configuration/oauth /oauth /oauth/*
		handle @mcpOAuth {
			reverse_proxy mcp-access-gateway:8081
		}

		@mcp path /mcp /mcp/*
		handle @mcp {
			reverse_proxy mcp-access-gateway:8081 {
				header_up -x-ai-base-traffic-origin
				header_up -traceparent
				header_up -tracestate
				header_up -baggage
				header_up -b3
				header_up -x-b3-traceid
				header_up -x-b3-spanid
				header_up -x-b3-parentspanid
				header_up -x-b3-sampled
				header_up -x-b3-flags
				header_up -x-request-id
				header_up -x-client-trace-id
				header_up -x-envoy-force-trace
				header_up -uber-trace-id
				header_up -x-ot-span-context
				header_up -ot-tracer-traceid
				header_up -ot-tracer-spanid
				header_up -ot-tracer-sampled
				header_up -grpc-trace-bin
				header_up -x-cloud-trace-context
				header_up -x-goog-cloud-trace-context
				header_up -x-amzn-trace-id
				header_up -agent-session-id
				header_up -x-session-id
				header_up -session-id
				header_up -x-user-id
				header_up -x-auth-request-user
				header_up -x-auth-request-email
				header_up -x-forwarded-user
				flush_interval -1
			}
		}

		handle /rag/health {
			uri strip_prefix /rag
			reverse_proxy lightrag:9621 {
				header_up X-API-Key {env.LIGHTRAG_API_KEY}
			}
		}

		@rag path /rag /rag/*
		handle @rag {
			uri strip_prefix /rag
			reverse_proxy lightrag:9621 {
				header_up X-API-Key {env.LIGHTRAG_API_KEY}
				flush_interval -1
			}
		}

		@runtime path /runtime /runtime/*
		handle @runtime {
			uri strip_prefix /runtime
			reverse_proxy agent-runtime:8000 {
				flush_interval -1
			}
		}

		@llmAdmin path /llm-admin /llm-admin/*
		handle @llmAdmin {
			uri strip_prefix /llm-admin
			reverse_proxy llm-gateway:1064
		}

		@connector path /connector /connector/*
		handle @connector {
			uri strip_prefix /connector
			reverse_proxy open-connector:3000 {
				flush_interval -1
			}
		}

		handle /knowledge {
			redir http://knowledge.localhost:8080/webui 308
		}

		@knowledgeApi path /knowledge/*
		handle @knowledgeApi {
			uri strip_prefix /knowledge
			reverse_proxy lightrag:9621 {
				header_up X-API-Key {env.LIGHTRAG_API_KEY}
				flush_interval -1
			}
		}

		@promptfoo path /promptfoo /promptfoo/*
		handle @promptfoo {
			uri strip_prefix /promptfoo
			reverse_proxy promptfoo:3000
		}

		handle / {
			header Content-Type application/json
			respond `{"service":"ai-base-global-gateway","routes":{"models":"/v1","mcp":"/mcp","mcpOAuth":"/oauth","rag":"/rag","runtime":"/runtime","connector":"/connector","knowledge":"/knowledge","promptfoo":"/promptfoo"}}`
		}

		handle {
			header Content-Type application/json
			respond `{"error":"not_found","message":"Unknown AI Base capability route"}` 404
		}
	}
}

http://runtime.localhost:8080 {
	reverse_proxy agent-runtime:8000 {
		flush_interval -1
	}
}

http://knowledge.localhost:8080 {
	reverse_proxy lightrag:9621 {
		header_up X-API-Key {env.LIGHTRAG_API_KEY}
		flush_interval -1
	}
}

http://promptfoo.localhost:8080 {
	reverse_proxy promptfoo:3000
}

https://ai-console.localhost.pomerium.io:8443 {
	tls internal

	route {
		@wecomBootstrap path /auth/wework/launch/* /auth/wework/status
		handle @wecomBootstrap {
			reverse_proxy ai-console:3000 {
				header_up -X-Pomerium-Jwt-Assertion
				header_up -X-Pomerium-Claim-Email
				header_up -X-Pomerium-Claim-Sub
				header_up -X-Pomerium-Claim-User
				header_up -X-Pomerium-Claim-Name
				header_up -X-Pomerium-Claim-Groups
				header_up -X-Pomerium-Authorization
			}
		}

		@wecomFirstLink path /auth/wework/link
		handle @wecomFirstLink {
			reverse_proxy https://pomerium:443 {
				header_up Host {host}:8443
				transport http {
					tls_insecure_skip_verify
				}
			}
		}

		@wecomSession header_regexp wecomSession Cookie "(^|;[ ]*)ai_base_wecom_session="
		handle @wecomSession {
			reverse_proxy ai-console:3000 {
				header_up -X-Pomerium-Jwt-Assertion
				header_up -X-Pomerium-Claim-Email
				header_up -X-Pomerium-Claim-Sub
				header_up -X-Pomerium-Claim-User
				header_up -X-Pomerium-Claim-Name
				header_up -X-Pomerium-Claim-Groups
				header_up -X-Pomerium-Authorization
			}
		}

		handle {
			reverse_proxy https://pomerium:443 {
				header_up Host {host}:8443
				transport http {
					tls_insecure_skip_verify
				}
			}
		}
	}
}

https://authenticate.localhost.pomerium.io:8443,
https://jaeger.localhost.pomerium.io:8443,
https://open-connector.localhost.pomerium.io:8443 {
	tls internal

	reverse_proxy https://pomerium:443 {
		header_up Host {host}:8443
		transport http {
			tls_insecure_skip_verify
		}
	}
}

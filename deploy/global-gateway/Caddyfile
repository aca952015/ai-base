{
	admin off
}

http://:8080 {
	header X-AI-Base-Gateway "functional"

	route {
		handle /health {
			header Content-Type application/json
			respond `{"status":"ok","service":"ai-base-global-gateway"}`
		}

		handle /ready {
			rewrite * /health
			reverse_proxy llm-gateway:1064
		}

		@wecomDomainVerification path_regexp wecomVerification ^/WW_verify_[A-Za-z0-9_-]+\.txt$
		handle @wecomDomainVerification {
			root * /srv/wecom-verification
			file_server
		}

		@models path /v1 /v1/*
		handle @models {
			reverse_proxy llm-gateway:1975 {
				flush_interval -1
			}
		}

		@mcpMetadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
		handle @mcpMetadata {
			reverse_proxy mcp-access-gateway:8081
		}

		@mcpOAuth path /.well-known/oauth-authorization-server/oauth /.well-known/openid-configuration/oauth /oauth /oauth/*
		handle @mcpOAuth {
			reverse_proxy mcp-access-gateway:8081
		}

		@mcp path /mcp /mcp/*
		handle @mcp {
			reverse_proxy mcp-access-gateway:8081 {
				flush_interval -1
			}
		}

		@wecomOIDC path /wecom-oidc/authorize /wecom-oidc/callback
		handle @wecomOIDC {
			uri strip_prefix /wecom-oidc
			reverse_proxy wecom-auth-bridge:8082
		}

		handle /rag/health {
			uri strip_prefix /rag
			reverse_proxy lightrag:9621 {
				header_up X-API-Key {env.LIGHTRAG_API_KEY}
			}
		}

		@rag path /rag /rag/*
		handle @rag {
			uri strip_prefix /rag
			reverse_proxy lightrag:9621 {
				header_up X-API-Key {env.LIGHTRAG_API_KEY}
				flush_interval -1
			}
		}

		@runtime path /runtime /runtime/*
		handle @runtime {
			uri strip_prefix /runtime
			reverse_proxy agent-runtime:8000 {
				flush_interval -1
			}
		}

		@llmAdmin path /llm-admin /llm-admin/*
		handle @llmAdmin {
			uri strip_prefix /llm-admin
			reverse_proxy llm-gateway:1064
		}

		@connector path /connector /connector/*
		handle @connector {
			uri strip_prefix /connector
			reverse_proxy open-connector:3000 {
				flush_interval -1
			}
		}

		handle /knowledge {
			redir http://knowledge.localhost:8080/webui 308
		}

		@knowledgeApi path /knowledge/*
		handle @knowledgeApi {
			uri strip_prefix /knowledge
			reverse_proxy lightrag:9621 {
				header_up X-API-Key {env.LIGHTRAG_API_KEY}
				flush_interval -1
			}
		}

		@jaeger path /jaeger /jaeger/*
		handle @jaeger {
			uri strip_prefix /jaeger
			reverse_proxy jaeger:16686
		}

		@promptfoo path /promptfoo /promptfoo/*
		handle @promptfoo {
			uri strip_prefix /promptfoo
			reverse_proxy promptfoo:3000
		}

		@otel path /otel /otel/*
		handle @otel {
			uri strip_prefix /otel
			reverse_proxy jaeger:4318 {
				flush_interval -1
			}
		}

		handle / {
			header Content-Type application/json
			respond `{"service":"ai-base-global-gateway","routes":{"models":"/v1","mcp":"/mcp","mcpOAuth":"/oauth","wecomOIDC":"/wecom-oidc","rag":"/rag","runtime":"/runtime","connector":"/connector","knowledge":"/knowledge","jaeger":"/jaeger","promptfoo":"/promptfoo","otelHttp":"/otel/v1/traces"}}`
		}

		handle {
			header Content-Type application/json
			respond `{"error":"not_found","message":"Unknown AI Base capability route"}` 404
		}
	}
}

http://runtime.localhost:8080 {
	reverse_proxy agent-runtime:8000 {
		flush_interval -1
	}
}

http://knowledge.localhost:8080 {
	reverse_proxy lightrag:9621 {
		header_up X-API-Key {env.LIGHTRAG_API_KEY}
		flush_interval -1
	}
}

http://jaeger.localhost:8080 {
	reverse_proxy jaeger:16686
}

http://promptfoo.localhost:8080 {
	reverse_proxy promptfoo:3000
}

https://authenticate.localhost.pomerium.io:8443,
https://ai-console.localhost.pomerium.io:8443,
https://open-connector.localhost.pomerium.io:8443 {
	tls internal

	@weworkLogin {
		host ai-console.localhost.pomerium.io
		path /auth/wework /auth/wework/
	}
	handle @weworkLogin {
		redir https://wework.localhost.pomerium.io:8443/account 302
	}

	reverse_proxy https://pomerium:443 {
		header_up Host {host}:8443
		transport http {
			tls_insecure_skip_verify
		}
	}
}

https://authenticate-wework.localhost.pomerium.io:8443,
https://wework.localhost.pomerium.io:8443 {
	tls internal
	reverse_proxy https://pomerium-wework:443 {
		header_up Host {host}:8443
		transport http {
			tls_insecure_skip_verify
		}
	}
}

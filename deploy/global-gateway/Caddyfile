{
	admin off
}

http://:8080 {
	header X-AI-Base-Gateway "functional"

	route {
		handle /health {
			header Content-Type application/json
			respond `{"status":"ok","service":"ai-base-global-gateway"}`
		}

		handle /ready {
			rewrite * /health
			reverse_proxy llm-gateway:1064
		}

		@models path /v1 /v1/*
		handle @models {
			reverse_proxy llm-gateway:1975 {
				flush_interval -1
			}
		}

		@mcpBrowser {
			method GET
			path /mcp /mcp/
			header Accept *text/html*
		}
		handle @mcpBrowser {
			header Content-Type application/json
			header Cache-Control no-store
			respond `{"service":"ai-base-mcp-gateway","transport":"streamable-http","status":"ready","message":"This is an MCP protocol endpoint. Connect with an MCP client; browser navigation does not create a session.","manageUrl":"https://ai-console.localhost.pomerium.io:8443/mcp"}`
		}

		@mcp path /mcp /mcp/*
		handle @mcp {
			reverse_proxy llm-gateway:1975 {
				flush_interval -1
			}
		}

		handle /rag/health {
			rewrite * /ready
			reverse_proxy agent-runtime:8000
		}

		@rag path /rag /rag/*
		handle @rag {
			reverse_proxy agent-runtime:8000 {
				flush_interval -1
			}
		}

		@runtime path /runtime /runtime/*
		handle @runtime {
			uri strip_prefix /runtime
			reverse_proxy agent-runtime:8000 {
				flush_interval -1
			}
		}

		@llmAdmin path /llm-admin /llm-admin/*
		handle @llmAdmin {
			uri strip_prefix /llm-admin
			reverse_proxy llm-gateway:1064
		}

		@connector path /connector /connector/*
		handle @connector {
			uri strip_prefix /connector
			reverse_proxy open-connector:3000 {
				flush_interval -1
			}
		}

		@knowledge path /knowledge /knowledge/*
		handle @knowledge {
			uri strip_prefix /knowledge
			reverse_proxy silverbullet:3000 {
				flush_interval -1
			}
		}

		@jaeger path /jaeger /jaeger/*
		handle @jaeger {
			uri strip_prefix /jaeger
			reverse_proxy jaeger:16686
		}

		@promptfoo path /promptfoo /promptfoo/*
		handle @promptfoo {
			uri strip_prefix /promptfoo
			reverse_proxy promptfoo:3000
		}

		@otel path /otel /otel/*
		handle @otel {
			uri strip_prefix /otel
			reverse_proxy jaeger:4318 {
				flush_interval -1
			}
		}

		handle / {
			header Content-Type application/json
			respond `{"service":"ai-base-global-gateway","routes":{"models":"/v1","mcp":"/mcp","rag":"/rag","runtime":"/runtime","connector":"/connector","knowledge":"/knowledge","jaeger":"/jaeger","promptfoo":"/promptfoo","otelHttp":"/otel/v1/traces"}}`
		}

		handle {
			header Content-Type application/json
			respond `{"error":"not_found","message":"Unknown AI Base capability route"}` 404
		}
	}
}

http://runtime.localhost:8080 {
	reverse_proxy agent-runtime:8000 {
		flush_interval -1
	}
}

http://knowledge.localhost:8080 {
	reverse_proxy silverbullet:3000 {
		flush_interval -1
	}
}

http://jaeger.localhost:8080 {
	reverse_proxy jaeger:16686
}

http://promptfoo.localhost:8080 {
	reverse_proxy promptfoo:3000
}

https://authenticate.localhost.pomerium.io:8443,
https://ai-console.localhost.pomerium.io:8443,
https://open-connector.localhost.pomerium.io:8443 {
	tls internal
	reverse_proxy https://pomerium:443 {
		header_up Host {host}:8443
		transport http {
			tls_insecure_skip_verify
		}
	}
}

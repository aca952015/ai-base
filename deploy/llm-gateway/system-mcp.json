{
  "mcpServers": {
    "open-connector": {
      "type": "http",
      "url": "http://global-gateway:8080/connector/mcp",
      "headers": {
        "Authorization": "Bearer ${OPEN_CONNECTOR_RUNTIME_TOKEN}"
      }
    },
    "rag": {
      "type": "http",
      "url": "http://rag-mcp:8080/mcp",
      "headers": {
        "X-API-Key": "${LIGHTRAG_API_KEY}"
      }
    }
  }
}
